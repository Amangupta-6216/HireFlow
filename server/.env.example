PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/hireflow

# JWT Secrets
JWT_ACCESS_SECRET=hireflow_jwt_access_secret_super_secure_key_2026
JWT_REFRESH_SECRET=hireflow_jwt_refresh_secret_super_secure_key_2026
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# AWS S3 (Leave empty or mock for automatic local disk fallback mode)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=hireflow-resumes

# Nodemailer SMTP (Leave mock for automatic logger/console fallback mode)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="HireFlow Careers <no-reply@hireflow.dev>"
