{
  "info": {
    "_postman_id": "hireflow-complete-api-v1",
    "name": "HireFlow Job Portal API Collection",
    "description": "Production-ready Postman collection for the HireFlow MERN Job Portal covering all platform roles (Candidate, Company Owner, HR, Interviewer, Admin).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api",
      "type": "string"
    },
    {
      "key": "candidateToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "recruiterToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "adminToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Login (Candidate)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"candidate@hireflow.dev\",\n  \"password\": \"CandidatePassword123!\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Login (Recruiter Owner)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"owner@techcorp.com\",\n  \"password\": \"OwnerPassword123!\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Login (Admin)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@hireflow.dev\",\n  \"password\": \"AdminPassword123!\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/auth/refresh", "host": ["{{baseUrl}}"], "path": ["auth", "refresh"] }
          }
        },
        {
          "name": "Get Current User (Me)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{candidateToken}}" }],
            "url": { "raw": "{{baseUrl}}/auth/me", "host": ["{{baseUrl}}"], "path": ["auth", "me"] }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/auth/logout", "host": ["{{baseUrl}}"], "path": ["auth", "logout"] }
          }
        }
      ]
    },
    {
      "name": "2. Jobs",
      "item": [
        {
          "name": "Search & Filter Open Jobs",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/jobs?keyword=Senior&jobType=full-time&isRemote=true&page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["jobs"],
              "query": [
                { "key": "keyword", "value": "Senior" },
                { "key": "jobType", "value": "full-time" },
                { "key": "isRemote", "value": "true" },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Get Job Details by ID",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/jobs/:id", "host": ["{{baseUrl}}"], "path": ["jobs", ":id"] }
          }
        },
        {
          "name": "Create Job (Recruiter)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{recruiterToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Cloud DevOps Engineer\",\n  \"description\": \"Lead containerization, CI/CD pipelines, and Kubernetes infrastructure at TechCorp.\",\n  \"skills\": [\"Docker\", \"Kubernetes\", \"AWS\", \"Terraform\"],\n  \"jobType\": \"full-time\",\n  \"experienceLevel\": \"senior\",\n  \"location\": \"San Francisco, CA\",\n  \"isRemote\": true,\n  \"salaryMin\": 135000,\n  \"salaryMax\": 175000,\n  \"status\": \"open\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/jobs", "host": ["{{baseUrl}}"], "path": ["jobs"] }
          }
        },
        {
          "name": "Get Company Jobs (All statuses)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{recruiterToken}}" }],
            "url": { "raw": "{{baseUrl}}/jobs/company/all", "host": ["{{baseUrl}}"], "path": ["jobs", "company", "all"] }
          }
        },
        {
          "name": "Close Job",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{recruiterToken}}" }],
            "url": { "raw": "{{baseUrl}}/jobs/:id/close", "host": ["{{baseUrl}}"], "path": ["jobs", ":id", "close"] }
          }
        }
      ]
    },
    {
      "name": "3. Applications & Pipeline",
      "item": [
        {
          "name": "Candidate Apply to Job",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{candidateToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"coverLetter\": \"Excited to apply for this position!\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/jobs/:id/apply", "host": ["{{baseUrl}}"], "path": ["jobs", ":id", "apply"] }
          }
        },
        {
          "name": "Get Candidate Applications (My Applications)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{candidateToken}}" }],
            "url": { "raw": "{{baseUrl}}/applications/my-applications", "host": ["{{baseUrl}}"], "path": ["applications", "my-applications"] }
          }
        },
        {
          "name": "Get Recruiter Applicants by Job",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{recruiterToken}}" }],
            "url": { "raw": "{{baseUrl}}/applications/job/:jobId", "host": ["{{baseUrl}}"], "path": ["applications", "job", ":jobId"] }
          }
        },
        {
          "name": "Update Applicant Status (Shortlisted/Interview/Offer/Rejected)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{recruiterToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"Shortlisted\",\n  \"note\": \"Candidate portfolio cleared technical review\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/applications/:id/status", "host": ["{{baseUrl}}"], "path": ["applications", ":id", "status"] }
          }
        },
        {
          "name": "Get Presigned Resume URL",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{recruiterToken}}" }],
            "url": { "raw": "{{baseUrl}}/applications/:id/resume-url", "host": ["{{baseUrl}}"], "path": ["applications", ":id", "resume-url"] }
          }
        }
      ]
    },
    {
      "name": "4. Admin Oversight",
      "item": [
        {
          "name": "Get Platform Stats",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/admin/stats", "host": ["{{baseUrl}}"], "path": ["admin", "stats"] }
          }
        },
        {
          "name": "Approve or Block Company",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"approved\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/admin/companies/:id/status", "host": ["{{baseUrl}}"], "path": ["admin", "companies", ":id", "status"] }
          }
        },
        {
          "name": "Remove Job (Moderate)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/admin/jobs/:id", "host": ["{{baseUrl}}"], "path": ["admin", "jobs", ":id"] }
          }
        }
      ]
    }
  ]
}
